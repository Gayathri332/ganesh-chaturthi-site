# Web search fallback for the Ask Ganapati widget.
# Get a key from https://serpapi.com — the app works without it, it just
# skips the web lookup and answers from PDF stories only.
SERPAPI_KEY=

# Optional: lets Cohere's Command model weave the retrieved PDF passages
# + web snippets into a fluent answer. Without this, answers fall back
# to showing the best-matching excerpt directly.
#
# Get a key at https://dashboard.cohere.com/api-keys — the free "trial"
# key works for testing (~1,000 calls/month, resets monthly) but Cohere's
# terms restrict trial keys to evaluation only, not production traffic.
# See https://docs.cohere.com/docs/rate-limits.
COHERE_API_KEY=

# Optional override — defaults to Cohere's current flagship chat model.
# Check https://docs.cohere.com/docs/models for the latest model IDs.
COHERE_MODEL=
